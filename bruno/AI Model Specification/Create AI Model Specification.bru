meta {
  name: Create AI Model Specification
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/aiModelSpecification
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "name": "GPT-4 Spec",
    "description": "Specification for large language model",
    "version": "4.0",
    "state": "active",
    "category": "LLM",
    "modelType": "generative",
    "framework": "transformer",
    "isBundle": false
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("aiModelSpecId", res.body.id);
  }
}
