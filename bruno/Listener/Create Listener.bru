meta {
  name: Create Listener
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/listener
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "callback": "https://webhook.site/your-unique-url"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("listenerId", res.body.id);
  }
}
